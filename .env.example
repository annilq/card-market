# ───────────────────────────────────────────────
# 卡牌展示站 — 环境变量样例
# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略，不会提交）
# ───────────────────────────────────────────────

# ===== Directus（docker-compose 读取）=====
KEY="dev-only-key-please-change-in-production-0000000000"
SECRET="dev-only-secret-please-change-in-production-0000000000"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin12345"
PUBLIC_URL="http://localhost:8055"
CORS_ENABLED="true"
CORS_ORIGIN="true"
STORAGE_LOCATIONS="local"
STORAGE_LOCAL_DRIVER="local"
STORAGE_LOCAL_ROOT="/directus/uploads"

# ===== 前端（Vite/TanStack Start 读取）=====
# 服务端 SSR 抓取用的地址（与 Directus 同机可写 localhost）
DIRECTUS_URL="http://localhost:8055"
# 浏览器端抓取的公开地址（Vite 以 VITE_ 前缀注入客户端）
VITE_DIRECTUS_URL="http://localhost:8055"
# 选填：当 Directus 与前端分离部署时，浏览器端需要绝对地址；同机开发填 localhost 即可。
# 选填：站点自身的公网地址（如 https://example.com）。
# 用于 canonical / hreflang / og:url —— 这些标签必须是绝对地址。
# 正常部署时会从请求头（x-forwarded-host / x-forwarded-proto）自动推导；
# 只有在构建期静态求值、拿不到请求上下文时才需要显式设置。
# VITE_SITE_URL="https://example.com"
