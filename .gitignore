# ── 环境与密钥 ──
.env
.env.*
!.env.example
.secret_key


# ── 系统 ──
.DS_Store

# ── 各 AI 编码工具的本机钩子配置 ──
# 内容里写死 /Users/<name>/... 的绝对路径，换台机器就失效，因此不入库。
# 这些文件由对应工具自己在本地生成，克隆仓库后按需重装即可。
.codex/
.cursor/
.gemini/
.grok/

# ── 依赖与构建产物 ──
node_modules
dist
.tanstack

# ── 运行时数据（用户上传、健康检查等，不入库） ──
directus/uploads

# ── 截图产物 ──
# 只忽略截图本身：.scratch 下的规格与复核脚本是要入仓的，
# 上一版写成 .scratch/ 把整个目录挡在门外了。
# 复核脚本（.scratch/**/capture.mjs）可随时重生成，36MB 的 PNG 不进历史。
.scratch/**/shots/
resources
.workbuddy
